# Xcode (project is generated by XcodeGen from project.yml)
*.xcodeproj
*.xcworkspace
!Packages/**/*.xcworkspace
xcuserdata/
DerivedData/
build/

# FFmpeg, built from the Vendor/FFmpeg submodule by Scripts/build-ffmpeg.sh
Packages/FFmpeg/FFmpeg.xcframework/

# SwiftPM
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Personal signing settings (team ID), included by Config/Signing.xcconfig
Config/Local.xcconfig

# Local docs (the privacy policy stays tracked: the app and App Store Connect link to it)
docs/*
!docs/privacy.md
